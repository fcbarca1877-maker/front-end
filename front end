```css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #172033;
}


/* NAVBAR */

.navbar {
    height: 75px;
    padding: 0 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: #ffffff;

    border-bottom: 1px solid #e8ebf0;

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: 800;
}

.nav-links {
    display: flex;
    gap: 35px;
}

.nav-links a {
    text-decoration: none;
    color: #555;
    font-weight: 600;
}

.nav-links a:hover {
    color: #1d4ed8;
}


/* HERO */

.hero {
    min-height: 620px;

    padding: 80px 10%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: linear-gradient(
        135deg,
        #07111f,
        #10294a
    );

    color: white;
}

.hero-content {
    max-width: 650px;
}

.small-title {
    color: #3b82f6;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: 65px;
    line-height: 1.05;
    margin-bottom: 25px;
}

.hero h1 span {
    display: block;
    color: #60a5fa;
}

.hero p {
    font-size: 19px;
    line-height: 1.7;
    color: #d6deeb;
}

.hero-btn {
    display: inline-block;

    margin-top: 35px;

    padding: 15px 25px;

    background: #2563eb;

    color: white;

    border-radius: 8px;

    text-decoration: none;

    font-weight: bold;
}

.hero-btn:hover {
    background: #1d4ed8;
}

.football {
    font-size: 170px;

    animation: rotateBall 8s linear infinite;
}

@keyframes rotateBall {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}


/* PREDICTION */

.prediction-section {
    padding: 90px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title p {
    color: #2563eb;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-title h2 {
    font-size: 42px;
    margin: 10px 0;
}

.section-title span {
    color: #777;
}


/* CONTAINER */

.prediction-container {
    max-width: 1150px;
    margin: auto;

    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 30px;
}


/* FORM */

#predictionForm {
    background: white;

    padding: 35px;

    border-radius: 15px;

    box-shadow: 0 10px 40px rgba(0,0,0,0.07);
}

.form-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 22px;
}

.input-group {
    display: flex;
    flex-direction: column;
}

.input-group label {
    margin-bottom: 8px;

    font-size: 14px;

    font-weight: 700;
}

.input-group input,
.input-group select {

    padding: 13px;

    border: 1px solid #dce1e8;

    border-radius: 7px;

    font-size: 15px;

    outline: none;
}

.input-group input:focus,
.input-group select:focus {

    border-color: #2563eb;

    box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
}

.input-group small {
    margin-top: 5px;
    color: #888;
}


/* BUTTON */

.predict-btn {

    width: 100%;

    margin-top: 30px;

    padding: 17px;

    border: none;

    border-radius: 8px;

    background: #2563eb;

    color: white;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;
}

.predict-btn:hover {
    background: #1d4ed8;
}


/* RESULT */

.result-card {

    background: #07111f;

    color: white;

    border-radius: 15px;

    padding: 35px;

    text-align: center;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;
}

.result-icon {
    font-size: 50px;

    margin-bottom: 15px;
}

.result-card h3 {
    font-size: 22px;
}

.score {

    font-size: 75px;

    font-weight: 900;

    margin: 20px 0;

    color: #60a5fa;
}

.result-card p {
    color: #cbd5e1;

    line-height: 1.5;
}


/* METER */

.meter {

    width: 100%;

    height: 12px;

    background: #26364d;

    border-radius: 20px;

    overflow: hidden;

    margin-top: 25px;
}

#meterBar {

    width: 0%;

    height: 100%;

    background: #3b82f6;

    transition: width 1s ease;
}


/* ABOUT */

.about {

    padding: 90px 10%;

    background: white;
}

.about h2 {

    font-size: 42px;

    margin-bottom: 20px;
}

.about p {
    max-width: 700px;

    color: #666;

    line-height: 1.7;
}


/* STATS */

.stats {

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 20px;

    margin-top: 40px;
}

.stats div {

    padding: 25px;

    background: #f5f7fb;

    border-radius: 10px;

    text-align: center;
}

.stats strong {

    display: block;

    font-size: 30px;

    color: #2563eb;
}

.stats span {

    display: block;

    margin-top: 5px;

    color: #777;
}


/* FOOTER */

footer {

    padding: 30px;

    text-align: center;

    background: #07111f;

    color: #aaa;
}


/* RESPONSIVE */

@media(max-width: 900px) {

    .hero h1 {
        font-size: 45px;
    }

    .football {
        display: none;
    }

    .prediction-container {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }
}


@media(max-width: 600px) {

    .navbar {
        padding: 0 5%;
    }

    .nav-links {
        display: none;
    }

    .hero {
        padding: 60px 7%;
    }

    .hero h1 {
        font-size: 40px;
    }

    .prediction-section {
        padding: 60px 5%;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: 1fr;
    }
}
```
